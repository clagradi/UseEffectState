{
  "name": "@clagradi/effect-runtime",
  "version": "0.1.0",
  "description": "Better async effect primitive for React 18+",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clagradi/UseEffectState.git"
  },
  "bugs": {
    "url": "https://github.com/clagradi/UseEffectState/issues"
  },
  "homepage": "https://github.com/clagradi/UseEffectState#readme",
  "keywords": [
    "react",
    "hooks",
    "useeffect",
    "async",
    "abortcontroller",
    "effect",
    "concurrency"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "pack:check": "npm pack --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run pack:check"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@clagradi/effect-runtime",
  "version": "0.2.0",
  "description": "Tiny, dependency-free React hooks for async effects that cancel, clean up and race correctly: useEffectTask, useEffectState and useEvent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clagradi/UseEffectState.git"
  },
  "bugs": {
    "url": "https://github.com/clagradi/UseEffectState/issues"
  },
  "homepage": "https://github.com/clagradi/UseEffectState#readme",
  "keywords": [
    "react",
    "react-hooks",
    "hooks",
    "useeffect",
    "usestate",
    "async",
    "abortcontroller",
    "abort",
    "cancellation",
    "race-condition",
    "effect",
    "concurrency",
    "strict-mode"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run lint:pkg",
    "lint": "eslint .",
    "lint:pkg": "publint --strict && attw --pack .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test",
    "smoke:consumer": "node ./scripts/smoke-consumer.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
